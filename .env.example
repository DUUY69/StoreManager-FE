# Copy file này thành .env và sửa giá trị theo môi trường của bạn
# Vite chỉ load biến có tiền tố VITE_

# Base URL Backend API (BE chạy port 5000, không có dấu / ở cuối)
# Dev: để trống hoặc bỏ qua — FE tự dùng proxy Vite (/api → localhost:5000), tránh lỗi CORS.
# Production: bắt buộc set URL BE thật.
# VITE_API_BASE_URL=http://localhost:5000

# Dev only: gọi thẳng BE (bỏ proxy). Chỉ bật khi cần debug CORS/BE riêng.
# VITE_API_DIRECT=true

# Bật gọi API thật (true). Tắt = dùng mock (false). Cần = true để cập nhật trạng thái đơn gửi lên BE
VITE_USE_API=true

# Phạm vi trợ lý AI: oa (quản lý kho/đơn — mặc định) | chamcong (chấm công)
VITE_ASSISTANT_SYSTEM=oa
